# Copy to .env and put your actual Facebook Page access token here.
# Never upload .env to your public website.
# Loaded by Python and run_sync.sh; exported variables take precedence.
FB_TOKEN='PASTE_YOUR_PAGE_TOKEN_HERE'
# If /me shows the correct Page, you may leave this blank.
# For a user token with multiple managed Pages, select the Page here.
# FB_PAGE_ID='1234567890'
FB_API_VERSION='v26.0'
FB_PAGES='2'

# Public Meta app ID for the Messenger Send dialog
# FB_APP_ID='YOUR_NUMERIC_META_APP_ID'

# UAT banner and watermark are enabled by default. Set false for final release.
UAT_MODE='true'
